<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.sbclock.xposed"
    android:versionCode="25"
    android:versionName="1.0">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="uiMode|fontScale|locale|layoutDirection|orientation|screenSize" />

        <!-- 桌面图标由这个 alias 提供，禁用它可以隐藏桌面图标 -->
        <activity-alias
            android:name=".Launcher"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Xposed / LSPosed 模块标识 -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="状态栏时间格式调整（可用版本：MIUI 12/12.5/13/14、HyperOS 1.x/2.x/3.x）：24/12 小时制、秒显示、自定义格式，并可隐藏桌面图标。部分灵感来自 MIUITime（github.com/hestudio-community/MIUITime），感谢。" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />
    </application>

</manifest>
